# Copy to private/.env. Keep the real file private and out of Git.

NODE_ENV=production
HOST=127.0.0.1
PORT=3033

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Required when the central Schnueddels authentication integration is enabled.
AUTH_API_URL=https://schnueddels.de/auth/api
PROJECT_KEY=crypto
PROJECT_API_SECRET=

# Optional read-only Kraken portfolio integration. Leave blank to disable it.
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
WALLET_TIMEOUT_MS=10000

# Alerts stay disabled unless this is explicitly set to true and both values exist.
TELEGRAM_ALERTS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Historical trader component; leave these values blank to keep real trading unavailable.
TRADER_KRAKEN_API_KEY=
TRADER_KRAKEN_API_SECRET=
SIGNAL_BASE_URL=http://127.0.0.1:3033
