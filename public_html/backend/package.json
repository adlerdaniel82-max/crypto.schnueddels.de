{
  "name": "crypto-backend",
  "version": "1.0.0",
  "description": "Backend for the crypto signal dashboard",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --test test/*.test.js",
    "job:fetch-market-data": "node src/jobs/fetch-market-data.js",
    "job:generate-signals": "node src/jobs/generate-signals.js",
    "job:refresh-market": "npm run job:fetch-market-data && npm run job:generate-signals"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.4.1",
    "helmet": "^8.1.0",
    "mysql2": "^3.14.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
}
